# Base URL of the Knowlxcircle backend API.
#
# Vite inlines VITE_* variables at BUILD time, so this must be set wherever the app
# is built - locally, in CI (see .github/workflows/main_knowlxcirclefrontend.yml) and
# in the Vercel project settings. It cannot be changed on an already-built site.
#
# Keep the trailing slash: services request relative paths such as "v1/articles/".
VITE_API_BASE_URL=http://localhost:8000/api/
